<!DOCTYPE html>
<html lang="{{ locale ?? 'en' }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Profiler pack - {{ slug }}</title>
    <style>
        body { font: 16px/1.5 Georgia, serif; margin: 3rem auto; max-width: 40rem; padding: 0 1rem; }
        button, .btn { font: inherit; padding: .4rem .8rem; }
    </style>
</head>
<body>
    <h1>{{ slug }}{{ locale ? ' (' ~ locale ~ ')' }}</h1>
    <p>A page of the test application. Its styles are its own: nothing of the toolbar's should change them.</p>
    <ul>
        <li><a href="{{ path('page', {_locale: 'en'}) }}">English</a>, <a href="{{ path('page', {_locale: 'fr'}) }}">French</a>, <a href="{{ path('page', {_locale: 'de', slug: 'about', page: 2}) }}">German, "about", page 2</a></li>
        <li><a href="{{ path('plain') }}">A page whose route has no locale</a></li>
        <li><a href="{{ path('failing') }}">A page that fails</a></li>
        <li><a href="{{ path('page', {_locale: 'en', slug: 'bottom-nav'}) }}">A page with a navigation fixed along the bottom of the window</a></li>
        <li><a href="{{ path('page', {_locale: 'en', slug: 'cookie-panel'}) }}">A page with a cookie question floating at the bottom, over a navigation fixed along it</a></li>
    </ul>
    <p><button type="button" class="btn btn--neutral" id="ajax">Send an AJAX request</button> <output id="answer"></output></p>
    <script>
        document.getElementById('ajax').addEventListener('click', function () {
            var xhr = new XMLHttpRequest();
            xhr.open('GET', {{ path('ajax')|json_encode|raw }});
            xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
            xhr.onload = function () { document.getElementById('answer').textContent = xhr.responseText; };
            xhr.send();
        });
    </script>
    {% if 'bottom-nav' == slug or 'cookie-panel' == slug %}
    {# A phone's tab bar: the toolbar's place is above it. #}
    <nav id="bottom-nav" style="position: fixed; left: 0; right: 0; bottom: 0; height: 56px; display: flex; justify-content: space-around; align-items: center; background: #f4efe6; border-top: 1px solid #ccc;">
        <a href="{{ path('page', {_locale: 'en'}) }}">Home</a> <a href="{{ path('plain') }}">Plain</a> <a href="#">Info</a>
    </nav>
    {% endif %}
    {% if 'cookie-panel' == slug %}
    {# A cookie question, floating at the bottom as omnibase/consent's does, taller than a bar: the toolbar keeps clear of its buttons. "Customise" makes it taller, an answer closes it and the toolbar goes back down. #}
    <div id="cookie-panel" role="dialog" aria-label="Cookies" style="position: fixed; left: 1rem; bottom: 1rem; z-index: 1500; width: min(22rem, calc(100vw - 2rem)); box-sizing: border-box; padding: 1rem; background: #fff; border: 1px solid #ccc; border-radius: 14px; box-shadow: 0 12px 30px rgba(0, 0, 0, .16);">
        <p style="margin: 0 0 .6rem;">The site keeps only what makes it work.</p>
        <p id="cookie-details" hidden style="margin: 0 0 .6rem;">Your session, your language, your preferences. Nothing else: no ads, no tracking, no third party.</p>
        <p style="display: flex; gap: .5rem; margin: 0;"><button type="button" data-answer>Accept</button> <button type="button" data-answer>Refuse</button></p>
        <p style="margin: .5rem 0 0;"><button type="button" id="cookie-customise" aria-expanded="false">Customise</button></p>
    </div>
    <script>
        document.getElementById('cookie-customise').addEventListener('click', function () {
            document.getElementById('cookie-details').hidden = false;
            this.setAttribute('aria-expanded', 'true');
        });
        document.querySelectorAll('[data-answer]').forEach(function (button) {
            button.addEventListener('click', function () { document.getElementById('cookie-panel').hidden = true; });
        });
    </script>
    {% endif %}
    <!-- end of the page -->
</body>
</html>
