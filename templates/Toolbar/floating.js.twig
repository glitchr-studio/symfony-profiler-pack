            } else if (MINIMIZABLE && 'mouse' !== drag.pointer && 'pointerup' === event.type) {
                /* A double tap on the handle: what a double click does. */
                var now = Date.now();
                if (lastTap && now - lastTap.time <= DOUBLE_TAP && Math.abs(event.clientX - lastTap.x) < 30 && Math.abs(event.clientY - lastTap.y) < 30) {
                    lastTap = null;
                    tappedFold = now;
                    clickAfterFold = now;
                    foldAside(event.target.closest('.sf-toolbar-toggle-button'));
                } else {
                    lastTap = { time: now, x: event.clientX, y: event.clientY };
                }
            }
            drag = null;
        }

        if (resize) {
            write(WIDTH_KEY, String(Math.round(width())));
            resize = null;
            /* Kept where it was while it was resized, under the pointer; clear of the page's panels once let go. */
            settleNow();
        }
    }

    window.addEventListener('pointerup', release, true);
    window.addEventListener('pointercancel', release, true);

    /* The click a phone sends after the second tap of a double tap lands where the handle was: the toolbar has moved away by then, so it would reach the page under it (a link, a cookie panel). It reaches nothing; the toolbar's state is set by foldAside. Caught on the window, before any listener of the page. */
    window.addEventListener('click', function (event) {
        if (clickAfterFold && event.isTrusted && Date.now() - clickAfterFold < 700) {
            clickAfterFold = 0;
            event.stopImmediatePropagation();
            event.preventDefault();
        }
    }, true);

    /* A move that ends on the handle is not a click on it: the toolbar stays open or closed as it was. */
    window.addEventListener('click', function (event) {
        if (!onHandle(event)) {
            swallowClick = false;

            return;
        }
        if (swallowClick) {
            swallowClick = false;
            event.stopImmediatePropagation();
            event.preventDefault();
        }
    }, true);

    /* Sent to the left edge, its handle staying in view; back to its corner when it is there already. Open or closed as it was before the clicks. */
    function foldAside(toggle) {
        var box = bounds();
        var left = box ? -box.tipLeft : -(window.innerWidth - 5 * PADDING);
        var aside = applied.x <= left + ASIDE;
        hand = false;
        var placed = place(aside ? 0 : left, 0);
        x = placed.x;
        y = 0;
        write(POSITION_KEY, JSON.stringify({ x: x, y: y, hand: false }));

        window.setTimeout(function () {
            if (toggle && openBeforeClicks === bar.classList.contains('sf-toolbar-closed')) {
                toggle.click();
            }
            settleNow();
        }, 0);
    }

    if (MINIMIZABLE) {
        window.addEventListener('dblclick', function (event) {
            if (!bar) {
                return;
            }

            if (DRAGGABLE && onHandle(event)) {
                /* Already done by the double tap this double click comes from. */
                if (Date.now() - tappedFold < 600) {
                    return;
                }
                foldAside(event.target.closest('.sf-toolbar-toggle-button'));

                return;
            }

            if (onLeftEdge(event)) {
                var folded = width() <= FOLDED_WIDTH + 1;
                content.style.width = (folded ? Math.max(fullWidth, MIN_WIDTH) : FOLDED_WIDTH) + 'px';
                write(WIDTH_KEY, folded ? null : String(FOLDED_WIDTH));
                resize = null;
                event.preventDefault();
            }
        }, true);
    }

    window.addEventListener('resize', settleNow);
    if (window.visualViewport) {
        window.visualViewport.addEventListener('resize', settleNow);
    }

    /* Opened, closed, filled: the toolbar changes size, measured once its transitions are over; a bar or a panel of the page comes and goes, shown or hidden, slides in, a cookie question is answered. Not on a scroll: what scrolls is the page's content, which never moves the toolbar (the room under it is there for the page's end). */
    window.addEventListener('click', function (event) {
        if (onHandle(event)) {
            settleNow();
        }
    }, true);
    document.addEventListener('transitionend', function () { settle(); });
    document.addEventListener('animationend', function () { settle(); });
    window.addEventListener('consent:change', function () { settle(); });

    /* What changes inside a panel already found (the cookie question's countdown, each second) is no matter unless the panel changes size, which its ResizeObserver tells; and what changes inside a drawing (an SVG animation's thousands of shapes, glitchr's intro) never moves a panel. Each pass measures the page under a grid of points: on glitchr's intro, a pass a second over its 17,000 shapes froze the animation 80-160 ms each time. */
    function inPanel(node) {
        for (var i = 0; i < watched.length; i++) {
            if (watched[i] !== node && watched[i].contains(node)) {
                return true;
            }
        }

        return false;
    }

    function textOnly(record) {
        var nodes = Array.prototype.slice.call(record.addedNodes).concat(Array.prototype.slice.call(record.removedNodes));
        for (var i = 0; i < nodes.length; i++) {
            if (1 === nodes[i].nodeType) {
                return false;
            }
        }

        return true;
    }

    function matters(record) {
        var target = 1 === record.target.nodeType ? record.target : record.target.parentElement;
        if (!target || (bar && bar.contains(target) && 'attributes' === record.type)) {
            return false;
        }
        if (target.closest && target.closest('svg')) {
            return false;
        }
        if (resizes && inPanel(target) && ('attributes' === record.type || textOnly(record))) {
            return false;
        }

        return true;
    }

    acquire();
    new MutationObserver(function (records) {
        for (var i = 0; i < records.length; i++) {
            if (!bar || matters(records[i])) {
                acquire();
                settle();

                return;
            }
        }
    }).observe(document.documentElement, { childList: true, subtree: true, attributes: true, attributeFilter: ['hidden', 'class', 'open', 'aria-hidden', 'aria-expanded'] });
})();
